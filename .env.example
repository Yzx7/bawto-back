# Copiar a .env y completar. NUNCA commitear el .env real.

APP_ENV=dev
SERVER_PORT=:3009

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sacs_chatbots?sslmode=disable

# Clave para cifrar tokens de canal en reposo (32 bytes en hex → 64 chars).
# Generar: openssl rand -hex 32
TOKEN_ENC_KEY=

# WhatsApp Cloud API (nivel app de Meta)
WHATSAPP_VERIFY_TOKEN=       # token de verificación del webhook (lo eliges tú)
WHATSAPP_APP_SECRET=         # App Secret de la app de Meta (firma X-Hub-Signature-256)
FACEBOOK_APP_ID=            # App ID de Meta (Embedded Signup)
# WHATSAPP_API_BASE=https://graph.facebook.com   # override para tests/mock
# WHATSAPP_API_VERSION=v21.0

# IA — MiniMax (endpoint compatible con Anthropic)
MINIMAX_API_KEY=            # sk-... (va en .env, no aquí)
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic
# MINIMAX_MODEL=MiniMax-M2

# CORS: orígenes del frontend, separados por coma
CORS_ORIGINS=http://localhost:3000
