# Copiar a .env y completar. NUNCA commitear el .env real.

APP_ENV=dev
SERVER_PORT=:3009

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sacs_chatbots?sslmode=disable

# Clave para cifrar tokens de canal en reposo (32 bytes en hex → 64 chars).
# Generar: openssl rand -hex 32
TOKEN_ENC_KEY=

# WhatsApp Cloud API (nivel app de Meta)
WHATSAPP_VERIFY_TOKEN=       # token de verificación del webhook (lo eliges tú)
WHATSAPP_APP_SECRET=         # App Secret de la app de Meta (firma X-Hub-Signature-256)
FACEBOOK_APP_ID=            # App ID de Meta (Embedded Signup)
# WHATSAPP_API_BASE=https://graph.facebook.com   # override para tests/mock
# WHATSAPP_API_VERSION=v21.0

# IA — MiniMax (endpoint compatible con Anthropic)
MINIMAX_API_KEY=            # sk-... (va en .env, no aquí)
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic
# MINIMAX_MODEL=MiniMax-M3
# Tarifario usado para convertir el objeto `usage` de cada respuesta en USD.
# Los defaults corresponden a MiniMax-M3 pay-as-you-go (contexto <= 512K)
# al 2026-07-30.
# Al cambiar de proveedor/modelo, actualizar estos cinco valores en conjunto.
# AI_PROVIDER=minimax
# AI_INPUT_USD_PER_MILLION=0.30
# AI_OUTPUT_USD_PER_MILLION=1.20
# AI_CACHE_READ_USD_PER_MILLION=0.06
# AI_CACHE_WRITE_USD_PER_MILLION=0

# CORS: orígenes del frontend, separados por coma
CORS_ORIGINS=http://localhost:3000

# Feature flags de la migración multiflujo (PLAN §17). Los valores comentados son
# los de por defecto: sin tocar nada el backend se comporta como siempre.
# FLOWS_TABLE_ENABLED=false          # true = leer el grafo de `flows` (versión publicada)
# SCHEDULER_ENABLED=true             # false = kill switch del cron y del worker de entrega
# MULTI_FLOW_DISPATCH_ENABLED=false  # fase 7; hoy no lo lee nadie
# SCHEDULER_CATCHUP_WINDOW=2h        # ocurrencias más antiguas se auditan como omitidas
# SCHEDULER_LOCK_TIMEOUT=10m         # recupera runs abandonados por un worker
# SCHEDULER_CHAT_POSTPONE=2h         # espera si hay conversación/handoff activo
# SCHEDULER_WABA_MPS=5               # pacing compartido entre instancias por WABA
# REMINDER_CORRELATION_WINDOW=72h    # fallback sin mensaje citado; solo si hay un registro único
