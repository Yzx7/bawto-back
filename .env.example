# Copiar a .env y completar. NUNCA commitear el .env real.

APP_ENV=dev
SERVER_PORT=:3009

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sacs_chatbots?sslmode=disable

# Clave para cifrar tokens de canal en reposo (32 bytes en hex → 64 chars).
# Generar: openssl rand -hex 32
TOKEN_ENC_KEY=

# WhatsApp Cloud API (nivel app de Meta)
WHATSAPP_VERIFY_TOKEN=       # token de verificación del webhook (lo eliges tú)
WHATSAPP_APP_SECRET=         # App Secret de la app de Meta (firma X-Hub-Signature-256)
FACEBOOK_APP_ID=            # App ID de Meta (Embedded Signup)
# WHATSAPP_API_BASE=https://graph.facebook.com   # override para tests/mock
# WHATSAPP_API_VERSION=v21.0

# IA de texto — DeepSeek. Los nombres MINIMAX_* son históricos y se conservan
# para no romper los entornos existentes.
MINIMAX_API_KEY=            # clave DeepSeek (va en .env, no aquí)
AI_PROVIDER=deepseek
MINIMAX_BASE_URL=https://api.deepseek.com/anthropic
MINIMAX_MODEL=deepseek-v4-flash

# IA visual — marcar «Puede ver imágenes» en un nodo selecciona MiniMax-M3.
# Si falta esta clave, el nodo falla de forma explícita: nunca entrega la imagen
# a DeepSeek como fallback.
MINIMAX_M3_API_KEY=
# MINIMAX_M3_BASE_URL=https://api.minimax.io/anthropic
# MINIMAX_M3_MODEL=MiniMax-M3

# El tarifario **no** se configura: sale del catálogo del modelo
# (backend/engine/ai/rates.go) y se copia en cada fila de ai_usage_events.
# Un modelo fuera del catálogo no arranca, y un AI_PROVIDER que no concuerde
# con el modelo tampoco: antes ese descuido registraba meses de consumo con la
# tarifa de otro modelo, y esas filas no se pueden corregir después.

# El agente de texto puede usar el modelo Pro sin afectar al proveedor visual:
# MINIMAX_MODEL=deepseek-v4-pro
# Ojo: un nombre de modelo que DeepSeek no reconozca lo sirve como
# deepseek-v4-flash **en silencio**, sin error.

# Override del tarifario, solo para un cambio de precio del proveedor antes de
# que se actualice el catálogo. Van las cuatro o ninguna: declarar solo algunas
# deja el resto en cero sin avisar, y un costo a la baja parece un dato bueno.
# AI_INPUT_USD_PER_MILLION=0.14
# AI_OUTPUT_USD_PER_MILLION=0.28
# AI_CACHE_READ_USD_PER_MILLION=0.0028
# AI_CACHE_WRITE_USD_PER_MILLION=0

# CORS: orígenes del frontend, separados por coma
CORS_ORIGINS=http://localhost:3000

# Feature flags de la migración multiflujo (PLAN §17). Los valores comentados son
# los de por defecto: sin tocar nada el backend se comporta como siempre.
# FLOWS_TABLE_ENABLED=false          # true = leer el grafo de `flows` (versión publicada)
# SCHEDULER_ENABLED=true             # false = kill switch del cron y del worker de entrega
# MULTI_FLOW_DISPATCH_ENABLED=false  # fase 7; hoy no lo lee nadie
# SCHEDULER_CATCHUP_WINDOW=2h        # ocurrencias más antiguas se auditan como omitidas
# SCHEDULER_LOCK_TIMEOUT=10m         # recupera runs abandonados por un worker
# SCHEDULER_CHAT_POSTPONE=2h         # espera si hay conversación/handoff activo
# SCHEDULER_WABA_MPS=5               # pacing compartido entre instancias por WABA
# REMINDER_CORRELATION_WINDOW=72h    # fallback sin mensaje citado; solo si hay un registro único
