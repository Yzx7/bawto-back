        "field.proveedor": "{receipt.provider}",
        "field.monto": "{receipt.amount}",
        "field.moneda": "{receipt.currency}",
        "field.fecha": "{receipt.occurredAt}",
        "field.operacion": "{receipt.operationCode}",
        "field.estado": "{receipt.branch}"
