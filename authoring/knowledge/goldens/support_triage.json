    {"id": "e-clarify", "source": "orchestrator", "target": "resume", "sourceHandle": "clarify"},
    {"id": "e-orchestrator-handoff", "source": "orchestrator", "target": "handoff", "sourceHandle": "handoff"},
    {"id": "e-resolved", "source": "specialist", "target": "resume", "sourceHandle": "resolved"},
    {"id": "e-specialist-clarify", "source": "specialist", "target": "resume", "sourceHandle": "clarify"},
    {"id": "e-specialist-handoff", "source": "specialist", "target": "handoff", "sourceHandle": "handoff"},
    {"id": "e-resume", "source": "resume", "target": "orchestrator", "role": "loopback"},
