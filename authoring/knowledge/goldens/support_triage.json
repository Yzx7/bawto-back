      "agentRole": "specialist", "contextMode": "recent"
    },
    {"id": "resume", "kind": "wait", "pos": {"x": 640, "y": 80}, "saveAs": "support_reply"},
    {"id": "handoff", "kind": "action", "pos": {"x": 640, "y": -180}, "action": "handoff", "params": {"reason": "support"}},
